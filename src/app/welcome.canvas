		{
			"id": "18c0fcb5b7290b88",
			"type": "text",
			"text": "Right-click empty space for board options like **Auto-layout** and **Snap to grid**.",
			"x": 24,
			"y": 36,
			"width": 323,
			"height": 81
		},
		{
			"id": "tip_palette",
			"type": "text",
			"x": -14,
			"y": -625,
			"width": 392,
			"height": 90,
			"text": "Press **Cmd/Ctrl+Shift+P** for the command palette \u2014 every action, searchable: switch board, change theme or font, auto-layout, group."
